# Copy to .env on the server. Never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
CORS_ORIGINS=https://your-app.vercel.app
# Optional
# WEB_CONCURRENCY=1          # more than 1 needs DATABASE_URL (in-memory store and rate limiter are per worker)
# WALKBACK_MAX_RUNS=500      # cap of the in-memory run store (ignored when DATABASE_URL is set)
# WALKBACK_RATE_PER_MIN=30   # per client IP, per worker
# FORWARDED_ALLOW_IPS=*      # only when a reverse proxy is the sole client of the API
