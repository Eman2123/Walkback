# Development: leave VITE_API_URL unset. The dev server proxies /api to VITE_DEV_API
# (default http://127.0.0.1:8000), so no CORS setup is needed.
# VITE_DEV_API=http://127.0.0.1:8000

# Production build only (set it in the Vercel project settings): the public URL of the API.
# VITE_API_URL=https://your-api.example.com
